{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditingManifest",
  "description": "Deterministic editing manifest for video generation engine (FFmpeg or Remotion)",
  "type": "object",
  "required": [
    "content_id",
    "project",
    "platform",
    "format",
    "canvas",
    "timeline"
  ],
  "properties": {
    "content_id": { "type": "string" },
    "project": { "type": "string" },
    "campaign": { "type": "string" },
    "platform": { "type": "string", "enum": ["instagram", "facebook", "youtube_shorts", "youtube_longform", "generic"] },
    "format": { "type": "string", "enum": ["reel", "short", "tutorial", "demo", "promo", "educational"] },
    "renderer": { "type": "string", "enum": ["ffmpeg", "remotion"] },
    "composition_id": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_seconds"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" },
        "duration_seconds": { "type": "number" },
        "aspect_ratio": { "type": "string" }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "start_time", "duration"],
        "properties": {
          "shot_id": { "type": "string" },
          "source_file": { "type": "string" },
          "start_time": { "type": "number" },
          "duration": { "type": "number" },
          "source_start": { "type": "number" },
          "source_duration": { "type": "number" },
          "playback_rate": { "type": "number" },
          "freeze": { "type": "boolean" },
          "text_overlays": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "style": { "type": "string" },
                "position_y": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "bgm_file": { "type": "string" },
        "bgm_volume": { "type": "number" },
        "voiceover_file": { "type": "string" },
        "voiceover_volume": { "type": "number" },
        "mute_source_audio": { "type": "boolean" }
      }
    },
    "output_target": { "type": "string" }
  }
}
